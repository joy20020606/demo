{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @sme-crm/db prisma generate"
  },
  "deploy": {
    "startCommand": "pnpm --filter @sme-crm/db prisma migrate deploy && pnpm --filter @sme-crm/api start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
