# ============================================================
# mini-sme-crm — Environment Variables Template
# ============================================================
# Copy this file to .env in each package that needs it.
# Each package should have its own .env in its own folder.
# ============================================================

# ---- Database (PostgreSQL) ----
# 本機 Docker 預設值即可；部署到 Railway 時改成 Railway 給的 URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sme_crm?schema=public"

# ---- API Server ----
API_PORT=3001
API_HOST=0.0.0.0

# ---- Auth (JWT) ----
# 用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 產生
JWT_SECRET="change-me-please-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- AI (Claude API) ----
# 從 https://console.anthropic.com/settings/keys 拿
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Deployment (用於 production 區分) ----
NODE_ENV="development"
