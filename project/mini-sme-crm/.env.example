# ============================================================
# mini-sme-crm — Environment Variables Template
# ============================================================
# 本地開發：複製這個檔案成 .env，docker compose up -d 之後直接可用
# Railway 部署：env 在 Railway UI 設，不需要 .env
# Vercel 部署：env 在 Vercel UI 設，不需要 .env
# ============================================================

# ============================================================
# 本地開發必要 vars
# ============================================================

# ---- Database (PostgreSQL) ----
# 本機 Docker 預設值即可
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sme_crm?schema=public"

# ---- API Server ----
API_PORT=3001
API_HOST=0.0.0.0

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- AI (Claude API) — Phase 5+ 才會用到 ----
# 從 https://console.anthropic.com/settings/keys 拿
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Environment ----
NODE_ENV="development"


# ============================================================
# Railway 部署需要設的 env（在 Railway dashboard 設定）
# ============================================================
#
# DATABASE_URL          ← Railway PostgreSQL plugin 會自動注入，不用自己設
# NODE_ENV              ← production
# FRONTEND_URL          ← Vercel 拿到的網址，例如 https://mini-sme-crm.vercel.app
# API_PUBLIC_URL        ← Railway API 的公開網址（Swagger UI 顯示用），例如 https://your-api.up.railway.app
# ANTHROPIC_API_KEY     ← Phase 5+ 才需要
#
# 注意：Railway 會自動注入 PORT，不要手動設
#

# ============================================================
# Vercel 部署需要設的 env（在 Vercel dashboard 設定）
# ============================================================
#
# NEXT_PUBLIC_API_URL   ← 指向 Railway 給的 API 網址，例如 https://your-api.up.railway.app
#                         ⚠️ NEXT_PUBLIC_ 前綴必須有，否則 client-side 拿不到
#
