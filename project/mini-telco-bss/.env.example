# --- Backend ---
APP_NAME=mini-telco-bss
APP_ENV=development
DEBUG=true

# Postgres (matches docker-compose.yml)
POSTGRES_USER=telco
POSTGRES_PASSWORD=telco_dev_pw
POSTGRES_DB=telco_bss
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy DSN (overrides POSTGRES_* if set)
DATABASE_URL=postgresql+asyncpg://telco:telco_dev_pw@localhost:5432/telco_bss

# JWT
JWT_SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Webhook
WEBHOOK_HMAC_SECRET=change-me-webhook-secret

# Rate limit
RATE_LIMIT_DEFAULT=100/minute

# --- Frontend (Vite reads VITE_*) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
