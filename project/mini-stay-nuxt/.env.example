# Railway PostgreSQL 公開連線字串,結尾加 ?sslmode=require
NUXT_DATABASE_URL=postgresql://user:password@host:5432/railway?sslmode=require

# 後台登入密碼(單一共用密碼,見 docs/PLAN.md「不做清單」)
NUXT_ADMIN_PASSWORD=change-me

# Cookie 簽章金鑰,至少 32 字元隨機字串
NUXT_SESSION_SECRET=change-me-to-a-long-random-string

# Vercel 新增變數時記得展開 Environments 勾選 Production
