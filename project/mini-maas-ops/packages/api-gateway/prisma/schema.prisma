// ----------------------------------------------------------------
// Prisma schema — Mini MaaS Ops
// 設計原則：
//   1. 每個業務表都有 tenantId + @@index([tenantId])，多租戶資料隔離
//   2. 用 cuid() 作 primary key（比 uuid 短、可排序、URL-safe）
//   3. 時間欄位統一 createdAt / updatedAt
// ----------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Tenant 組織 (城市運輸局、企業) -----
model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  routes            Route[]
  incentivePrograms IncentiveProgram[]

  @@map("tenants")
}

// ----- User 使用者 -----
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(VIEWER)
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

// ----- Route 通勤路線 -----
model Route {
  id            String   @id @default(cuid())
  name          String
  startLocation Json     @map("start_location") // { lat, lng, address }
  endLocation   Json     @map("end_location")
  distanceKm    Float    @map("distance_km")
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@map("routes")
}

// ----- IncentiveProgram 行為引導獎勵方案 -----
model IncentiveProgram {
  id          String                 @id @default(cuid())
  name        String
  description String
  budget      Decimal                @db.Decimal(12, 2)
  status      IncentiveProgramStatus @default(DRAFT)
  tenantId    String                 @map("tenant_id")
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([tenantId, status])
  @@map("incentive_programs")
}

enum IncentiveProgramStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
}
