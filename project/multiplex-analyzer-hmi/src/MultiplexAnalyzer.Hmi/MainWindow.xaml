<Window x:Class="MultiplexAnalyzer.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiplexAnalyzer.Hmi.ViewModels"
        Title="MultiPlex Analyzer HMI"
        Height="900" Width="1440"
        Background="{DynamicResource Brush.Surface.Base}">

    <Window.DataContext>
        <vm:ShellViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 Style="{StaticResource Nav.List}"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNav}"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                DataContext="{Binding Dashboard}">
                        <Ellipse Style="{StaticResource StatusDot}"/>
                        <TextBlock Text="{Binding State}" Style="{StaticResource Text.Body}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="20" Margin="20,0"
                                   Fill="{DynamicResource Brush.Border.Subtle}"/>
                        <TextBlock Text="Remaining" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RemainingLabel}" Style="{StaticResource Text.Body}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Height="40" MinWidth="150"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding Theme}"/>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>
