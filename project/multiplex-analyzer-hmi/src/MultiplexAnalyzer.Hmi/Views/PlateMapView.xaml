<UserControl x:Class="MultiplexAnalyzer.Hmi.Views.PlateMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MultiplexAnalyzer.Hmi.Controls"
             xmlns:conv="clr-namespace:MultiplexAnalyzer.Hmi.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:FractionToWidthConverter x:Key="FractionToWidth"/>

        <Style x:Key="Toolbar.Button" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="DetailPanel" TargetType="Border">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="40"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="40" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MarkerRowTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>

                <Grid Grid.Column="1" Height="10" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{DynamicResource Brush.Surface.Sunken}"/>
                    <Border x:Name="Bar" CornerRadius="5" HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Border.Strong}"
                            Width="{Binding Signal, Converter={StaticResource FractionToWidth}, ConverterParameter=150}"/>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding SignalLabel}" Margin="10,0,0,0"
                           Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>

                <Border x:Name="Tag" Grid.Column="3" CornerRadius="{StaticResource Radius.S}"
                        Padding="6,2" HorizontalAlignment="Right"
                        Background="{DynamicResource Brush.Surface.Sunken}">
                    <TextBlock x:Name="TagText" Text="{Binding CallLabel}" FontSize="11" FontWeight="SemiBold"
                               FontFamily="{StaticResource Font.Family}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPositive}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Status.Error}"/>
                    <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Brush.Status.Error}"/>
                    <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page.Root}" Margin="{StaticResource Space.5.All}">
        <Grid.RenderTransform>
            <TranslateTransform Y="8"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="-" Style="{StaticResource Toolbar.Button}" Command="{Binding ZoomOutCommand}"/>
                <TextBlock Text="{Binding ZoomLabel}" Style="{StaticResource Text.Body}"
                           MinWidth="56" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="+" Style="{StaticResource Toolbar.Button}" Command="{Binding ZoomInCommand}"/>
                <Button Content="Reset view" Style="{StaticResource Toolbar.Button}" Command="{Binding ResetViewCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="{DynamicResource Brush.Status.Error}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Run Text="{Binding PositiveWellCount, Mode=OneWay}"/>
                    <Run Text="wells with at least one positive marker"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="{StaticResource Radius.M}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                    ClipToBounds="True">
                <controls:PlateMapControl Wells="{Binding Wells}"
                                          Rows="{Binding Rows}"
                                          Columns="{Binding Columns}"
                                          SelectedWell="{Binding SelectedWell}"
                                          Zoom="{Binding Zoom}"
                                          OffsetX="{Binding OffsetX}"
                                          OffsetY="{Binding OffsetY}"/>
            </Border>

            <Border Grid.Column="1" Width="340" Margin="16,0,0,0"
                    Style="{StaticResource DetailPanel}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.M}"
                    Padding="{StaticResource Space.5.All}"
                    DataContext="{Binding}">
                <Grid DataContext="{Binding SelectedWell}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Display}"/>
                        <TextBlock Text="Well" Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding SummaryLabel}"
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,20"/>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Markers}"
                                  ItemTemplate="{StaticResource MarkerRowTemplate}"/>

                    <Button Grid.Row="3" Content="Close" Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0"
                            Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
