<UserControl x:Class="MultiplexAnalyzer.Hmi.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MultiplexAnalyzer.Hmi.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="ProtocolStepTemplate">
            <Border x:Name="Row" Margin="0,0,0,8" Padding="16,14"
                    CornerRadius="{StaticResource Radius.M}"
                    Background="{DynamicResource Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Center"
                             Fill="{DynamicResource Brush.Border.Strong}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="14,0,0,0"
                               Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationLabel}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Status.Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Accent.Default}"/>
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Dot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.2" Duration="0:0:0.7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page.Root}">
        <Grid.RenderTransform>
            <TranslateTransform Y="8"/>
        </Grid.RenderTransform>

        <Grid Margin="{StaticResource Space.5.All}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:ProgressRing Progress="{Binding Progress}">
                        <StackPanel>
                            <TextBlock Text="{Binding ProgressLabel}"
                                       FontFamily="{StaticResource Font.Family}" FontSize="52"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="{Binding RemainingLabel}"
                                       Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </controls:ProgressRing>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Ellipse Style="{StaticResource StatusDot}"/>
                        <TextBlock Text="{Binding State}" Style="{StaticResource Text.Title}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Protocol" Style="{StaticResource Text.Title}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Steps}"
                                  ItemTemplate="{StaticResource ProtocolStepTemplate}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="Start Run" Style="{StaticResource Button.Primary}"
                        Command="{Binding StartCommand}" Margin="0,0,12,0"/>
                <Button Content="{Binding PauseResumeLabel}" Style="{StaticResource Button.Secondary}"
                        Command="{Binding PauseResumeCommand}" Margin="0,0,12,0"/>
                <Button Content="Abort" Style="{StaticResource Button.Secondary}"
                        Command="{Binding RequestAbortCommand}" Margin="0,0,12,0"/>
                <Button Content="Inject Error" Style="{StaticResource Button.Secondary}"
                        Command="{Binding InjectErrorCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Background="#99000000"
              Visibility="{Binding IsAbortDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.L}"
                    Padding="{StaticResource Space.5.All}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.9" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.9" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <TextBlock Text="Abort this run?" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="The plate will be marked as incomplete and the current protocol step is lost."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Keep Running" Style="{StaticResource Button.Secondary}"
                                Command="{Binding CancelAbortCommand}" Margin="0,0,12,0"/>
                        <Button Content="Abort" Style="{StaticResource Button.Primary}"
                                Command="{Binding ConfirmAbortCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
