<UserControl x:Class="MultiplexAnalyzer.Hmi.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MultiplexAnalyzer.Hmi.Controls">

    <Grid Style="{StaticResource Page.Root}" Margin="{StaticResource Space.5.All}">
        <Grid.RenderTransform>
            <TranslateTransform Y="8"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Run parameters" Style="{StaticResource Text.Title}" Margin="0,0,0,12"/>
                <Border Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.M}"
                        Padding="{StaticResource Space.5.All}" Margin="0,0,0,32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,20">
                            <TextBlock Text="Read mode" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="Trade-off between scan time and signal sensitivity"
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,20"
                                 Style="{StaticResource SegmentedControl}"
                                 ItemsSource="{Binding ReadModes}"
                                 SelectedItem="{Binding SelectedReadMode}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,20">
                            <TextBlock Text="Incubation temperature" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="30 - 45 C, 0.5 steps. Press and hold to repeat."
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <controls:NumericStepper Grid.Row="1" Grid.Column="1" Margin="0,0,0,20"
                                                 Value="{Binding IncubationTemperature}"
                                                 Minimum="30" Maximum="45" Step="0.5" Unit="C"/>

                        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,20">
                            <TextBlock Text="Wash cycles" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="1 - 10 cycles per protocol step"
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <controls:NumericStepper Grid.Row="2" Grid.Column="1" Margin="0,0,0,20"
                                                 Value="{Binding WashCycles}"
                                                 Minimum="1" Maximum="10" Step="1" Unit="x"/>

                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,20">
                            <TextBlock Text="Auto export results" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="Write a CSV report when a run completes"
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Grid.Row="3" Grid.Column="1" Margin="0,0,0,20"
                                      HorizontalAlignment="Right"
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AutoExportEnabled}"/>

                        <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Audible alerts" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="Beep on run completion and on error"
                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Grid.Row="4" Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding SoundAlertsEnabled}"/>
                    </Grid>
                </Border>

                <TextBlock Text="Surface + Accent" Style="{StaticResource Text.Title}" Margin="0,0,0,12"/>
                <UniformGrid Rows="1" Margin="0,0,0,32">
                    <Border Background="{DynamicResource Brush.Surface.Base}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.M}" Height="88" Margin="0,0,12,0">
                        <TextBlock Text="Surface.Base" Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.M}" Height="88" Margin="0,0,12,0">
                        <TextBlock Text="Surface.Raised" Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Sunken}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.M}" Height="88" Margin="0,0,12,0">
                        <TextBlock Text="Surface.Sunken" Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="{DynamicResource Brush.Accent.Default}"
                            CornerRadius="{StaticResource Radius.M}" Height="88">
                        <TextBlock Text="Accent.Default" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Status" Style="{StaticResource Text.Title}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Status.Idle}"/>
                        <TextBlock Text="Idle" Style="{StaticResource Text.Body}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Status.Running}"/>
                        <TextBlock Text="Running" Style="{StaticResource Text.Body}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Status.Paused}"/>
                        <TextBlock Text="Paused" Style="{StaticResource Text.Body}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Status.Error}"/>
                        <TextBlock Text="Error" Style="{StaticResource Text.Body}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Status.Ok}"/>
                        <TextBlock Text="Completed" Style="{StaticResource Text.Body}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Buttons (48dp touch target)" Style="{StaticResource Text.Title}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Button Content="Start Run" Style="{StaticResource Button.Primary}" Margin="0,0,12,0"/>
                    <Button Content="Load Plate" Style="{StaticResource Button.Secondary}" Margin="0,0,12,0"/>
                    <Button Content="Disabled" Style="{StaticResource Button.Primary}" IsEnabled="False"/>
                </StackPanel>

                <Border Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.M}" Padding="{StaticResource Space.5.All}">
                    <StackPanel>
                        <TextBlock Text="StaticResource vs DynamicResource" Style="{StaticResource Text.Title}"/>
                        <TextBlock Text="Both squares bind to Brush.Surface.Sunken. Toggle the theme and watch only one repaint."
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,32,0">
                                <Border Width="220" Height="88"
                                        Background="{StaticResource Brush.Surface.Sunken}"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.S}"/>
                                <TextBlock Text="StaticResource - frozen at load"
                                           Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <Border Width="220" Height="88"
                                        Background="{DynamicResource Brush.Surface.Sunken}"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.S}"/>
                                <TextBlock Text="DynamicResource - live lookup"
                                           Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
