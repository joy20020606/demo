<UserControl x:Class="MultiplexAnalyzer.Hmi.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Style="{StaticResource Page.Root}" Margin="{StaticResource Space.5.All}">
        <Grid.RenderTransform>
            <TranslateTransform Y="8"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.M}">
            <TextBlock Text="Not implemented yet"
                       Style="{StaticResource Text.Body}"
                       Foreground="{DynamicResource Brush.Text.Disabled}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
