                <ResourceDictionary Source="Themes/Controls/NumericStepper.xaml"/>
                <ResourceDictionary Source="Themes/Controls/ProgressRing.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Status.xaml"/>
                <ResourceDictionary Source="Themes/Controls/PlateMap.xaml"/>
                <ResourceDictionary Source="Themes/Controls/TextBox.xaml"/>
