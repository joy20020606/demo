<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Surface.Base"    Color="#161616"/>
    <SolidColorBrush x:Key="Brush.Surface.Raised"  Color="#262626"/>
    <SolidColorBrush x:Key="Brush.Surface.Sunken"  Color="#0B0B0B"/>

    <SolidColorBrush x:Key="Brush.Text.Primary"    Color="#F4F4F4"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary"  Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled"   Color="#6F6F6F"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent"   Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Border.Subtle"   Color="#393939"/>
    <SolidColorBrush x:Key="Brush.Border.Strong"   Color="#6F6F6F"/>

    <SolidColorBrush x:Key="Brush.Accent.Default"  Color="#4589FF"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover"    Color="#78A9FF"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed"  Color="#0F62FE"/>

    <SolidColorBrush x:Key="Brush.Status.Idle"     Color="#6F6F6F"/>
    <SolidColorBrush x:Key="Brush.Status.Running"  Color="#4589FF"/>
    <SolidColorBrush x:Key="Brush.Status.Paused"   Color="#F1C21B"/>
    <SolidColorBrush x:Key="Brush.Status.Error"    Color="#FA4D56"/>
    <SolidColorBrush x:Key="Brush.Status.Ok"       Color="#42BE65"/>

</ResourceDictionary>
