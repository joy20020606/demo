<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource Brush.Status.Idle}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Running}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Paused">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Paused}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Completed">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Ok}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Error}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
