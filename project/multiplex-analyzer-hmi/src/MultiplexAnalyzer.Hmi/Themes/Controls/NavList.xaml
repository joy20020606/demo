<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MultiplexAnalyzer.Hmi.Converters">

    <conv:ResourceKeyToGeometryConverter x:Key="KeyToGeometry"/>

    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Height="76" Background="Transparent">
                        <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left"
                                Background="Transparent"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="Icon" Width="22" Height="22" Stretch="Uniform"
                                  Data="{Binding IconKey, Converter={StaticResource KeyToGeometry}}"
                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                  HorizontalAlignment="Center"/>
                            <TextBlock x:Name="Label" Text="{Binding Label}"
                                       FontFamily="{StaticResource Font.Family}" FontSize="11"
                                       Margin="0,6,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Base}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Base}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.List" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.Item}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
