@page "/"

<PageTitle>Chat</PageTitle>

<h1>文件問答</h1>
<p class="text-muted">Phase 1:假回答,尚未接 RAG。已送出 <strong>@_messages.Count(m => m.IsUser)</strong> 個問題。</p>

<div class="chat-log mb-3">
    @foreach (var m in _messages)
    {
        <div class="chat-msg @(m.IsUser ? "chat-user" : "chat-bot")">
            <div class="chat-role">@(m.IsUser ? "你" : "助理")</div>
            <div class="chat-text">@m.Text</div>
        </div>
    }
</div>

<form class="input-group" @onsubmit="Send">
    <input class="form-control" placeholder="輸入問題,按 Enter 送出"
           @bind="_question" @bind:event="oninput" disabled="@_busy" />
    <button type="submit" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_question))">送出</button>
</form>

@code {
    private readonly List<ChatMessage> _messages = [];
    private string _question = "";
    private bool _busy;

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_question) || _busy) return;

        var q = _question.Trim();
        _question = "";
        _busy = true;
        _messages.Add(new ChatMessage(true, q));

        await Task.Delay(300);
        _messages.Add(new ChatMessage(false, $"(假回答)你問了:「{q}」。Phase 4 之後這裡會用你上傳的文件回答並附引用來源。"));

        _busy = false;
    }

    private record ChatMessage(bool IsUser, string Text);
}
